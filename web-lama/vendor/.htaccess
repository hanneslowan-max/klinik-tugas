# Pustaka vendor bernama versi (mis. purify-3.4.16.es.mjs) → boleh di-cache setahun. muat.js tidak bernama versi.
<IfModule mod_headers.c>
  <FilesMatch "-[0-9]+\.[0-9]+\.[0-9]+\.(umd\.js|esm\.min\.mjs|es\.mjs|esm\.js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(muat\.js|VERSI\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
