# Env UJI LOKAL untuk `supabase functions serve --env-file uji/wa/serve.env` (uji/wa/kontrak.mjs; juga cukup untuk
# uji/iklan/kontrak.mjs). Nilai TIRUAN, BUKAN rahasia. Kapso, Claude, dan Telegram diarahkan ke server tiruan di mesin uji
# (uji/wa/kontrak.mjs, port 54398) lewat host.docker.internal — tidak ada panggilan ke layanan sungguhan.
# Secret produksi dipasang sebagai secret Edge (supabase secrets set), tidak di repo; lihat docs/WA-BOT.md.
TOKEN_UNGGAH_IKLAN=uji-lokal-token-unggah-iklan-000000000001
KAPSO_WEBHOOK_SECRET=uji-lokal-rahasia-webhook-kapso-0001
TOKEN_WA_PROSES=uji-lokal-token-proses-wa-00000000001
KAPSO_API_KEY=uji-lokal-kapso-tiruan
ANTHROPIC_API_KEY_WA=uji-lokal-ai-tiruan
TELEGRAM_BOT_TOKEN=uji-lokal-telegram-tiruan
TELEGRAM_CHAT_HANNES=111
TELEGRAM_CHAT_MARKETING=-222
TELEGRAM_CHAT_SALES=-333
KAPSO_API_URL=http://host.docker.internal:54398/kapso
ANTHROPIC_API_URL=http://host.docker.internal:54398/ai
TELEGRAM_API_URL=http://host.docker.internal:54398/tg
WA_IZINKAN_JAM_UJI=1
