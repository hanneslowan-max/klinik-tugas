# Tugas RHJ — Hostinger (Apache). Web statis SPA: rute /t/…, /l/…, /saya, dst. → index.html.
# SEBELUM DEPLOY: ganti GANTI_REF (2 tempat di CSP) dengan ref project Supabase (sama dengan config.js).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
AddType image/svg+xml .svg

# jangan layani berkas tersembunyi / catatan
<FilesMatch "^\.|\.(md|log|bak|sh)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # paksa HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # berkas/dir yang ada dilayani langsung
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # aset yang tidak ada → dibiarkan 404 biasa (bukan index.html)
  RewriteRule ^(css|js|vendor)/ - [L]
  RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]{1,8}$
  RewriteRule ^ - [L]
  # rute SPA
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob: data: https://GANTI_REF.supabase.co; connect-src 'self' https://GANTI_REF.supabase.co wss://GANTI_REF.supabase.co; font-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # cache: aset aplikasi selalu revalidasi (ETag) supaya rilis baru langsung terpakai.
  # vendor/ bernama versi → immutable (lihat vendor/.htaccess).
  <FilesMatch "\.(js|mjs|css|svg|png|webmanifest|html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(sw\.js|config\.js|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
