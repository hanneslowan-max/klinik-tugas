# Salin ke .env.local (lokal). Produksi: isi di Variabel environment Node.js app Hostinger SEBELUM build (README).
# Semua nilai publik (URL project + publishable key); JANGAN taruh service/secret key di sini.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Dasar tautan kartu yang disalin (sama dengan app_settings.app_base_url)
NEXT_PUBLIC_APP_BASE_URL=https://tugas.palletmeshindonesia.com
# Opsional: URL Edge Function api (bawaan: <SUPABASE_URL>/functions/v1/api)
# NEXT_PUBLIC_API_URL=
